    <tag k="air_conditioning" v="yes"/>
    <tag k="alt_name" v="海淀区中医医院"/>
    <tag k="amenity" v="clinic"/>
    <tag k="building" v="yes"/>
    <tag k="description" v="北京市海淀区双榆树社区卫生服务中心（海淀区中医医院）成立于1984年，是一所以中医为主的社区卫生服务中心。 目前中心承担着中关村街道南部17个居家委会社区约6万人的预防保健、基本医疗、慢病管理、社区康复、健康教育、计划生育服务等社区卫生服务工作。随着国家医疗改革的深入和社区医疗服务模式的改变,医院积极推进“以健康为中心、以家庭为单位、以社区为基础、以预防为导向” 的服务模式,积极开展健康管理、预防保健工作。中心现设有预防保健科、健康管理科、中医内科、外科、中医妇科、中医儿科，针灸推拿科、皮肤科、前列腺科等"/>
    <tag k="healthcare" v="clinic"/>
    <tag k="healthcare:speciality" v="general;chinese_traditional_medicine;中医科;针灸科;眼科;口腔科;中医骨科;中医儿科;中医皮肤科;妇科"/>
    <tag k="name" v="双榆树社区卫生服务中心"/>
    <tag k="name:ar" v="هايديان عيادة الطب الصيني التقليدي"/>
    <tag k="name:de" v="Haidian District Traditionelle Chinesische Medizinklinik"/>
    <tag k="name:en" v="Haidian traditional Chinese medicine clinic"/>
    <tag k="name:es" v="Clínica de medicina tradicional china del distrito de Haidian"/>
    <tag k="name:ja" v="海淀区漢方医院"/>
    <tag k="name:ko" v="해정 구 중의 진료소"/>
    <tag k="official_name" v="中关村社区卫生服务中心"/>
    <tag k="operator" v="公立"/>
