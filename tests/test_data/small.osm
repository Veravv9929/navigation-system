  <node id="9706378253" version="2" timestamp="2022-09-30T01:45:53Z" lat="39.9956664" lon="116.2984207">
    <tag k="historic" v="memorial"/>
    <tag k="inscription" v="台形规半月，白玉以为栏。即是广寒界，雅宜秋夕看。会当银魄满，不碍碧虚宽。太白镜湖句，常思欲和难。丙戌新秋御题。"/>
    <tag k="material" v="汉白玉"/>
    <tag k="name" v="乾隆半月台诗碑"/>
    <tag k="name:zh" v="乾隆半月台诗碑"/>
    <tag k="name:zh-Hans" v="乾隆半月台诗碑"/>
    <tag k="name:zh-Hant" v="乾隆半月臺詩碑"/>
  </node>
  <node id="9706378254" version="1" timestamp="2022-05-01T05:38:01Z" lat="39.9950191" lon="116.3004813"/>
  <node id="9706378255" version="1" timestamp="2022-05-01T05:38:01Z" lat="39.9950172" lon="116.3005812"/>
  <node id="9706378256" version="1" timestamp="2022-05-01T05:38:01Z" lat="39.9949331" lon="116.3005784"/>
  <node id="9706378257" version="1" timestamp="2022-05-01T05:38:01Z" lat="39.9949351" lon="116.3004785"/>
  <node id="9706378258" version="2" timestamp="2022-12-30T13:55:54Z" lat="39.995206" lon="116.3009569">
    <tag k="historic" v="memorial"/>
    <tag k="inscription" v="十景西湖名早传， 御园柳浪亦称旃。栗留叽啭无端听， 恰似清波门那边。&#xA;能言春鸟呼名字，罨尽云林自往回。几缕画情遮过客，一行烟意□新题。"/>
    <tag k="name" v="“柳浪闻莺“石坊楣"/>
    <tag k="name:zh" v="“柳浪闻莺“石坊楣"/>
    <tag k="name:zh-Hans" v="“柳浪闻莺“石坊楣"/>
    <tag k="name:zh-Hant" v="“柳浪聞鶯“石坊楣"/>
    <tag k="source" v="圆明园仿西湖十景遗石"/>
  </node>
  <node id="9706378259" version="2" timestamp="2022-12-26T04:05:33Z" lat="39.9959694" lon="116.3036026">
    <tag k="historic" v="memorial"/>
    <tag k="inscription" v="在昔桥头密雪铺，举头见额忆西湖。春巡几度曾来往，乃识西湖此不殊。癸未孟冬月。&#xA;杨柳似含烟羃䍥,楼台仍积玉嵯峨。&#xA;连树画景张横幅,着树梅花发野橋。"/>
    <tag k="name" v="“断桥残雪“石坊楣"/>
    <tag k="name:zh" v="“断桥残雪“石坊楣"/>
    <tag k="name:zh-Hans" v="“断桥残雪“石坊楣"/>
    <tag k="name:zh-Hant" v="“斷橋殘雪“石坊楣"/>
    <tag k="source" v="圆明园仿西湖十景遗石"/>
  </node>
