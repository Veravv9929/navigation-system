  <node id="13260542961" version="8" timestamp="2026-01-14T11:10:56Z" lat="39.9924196" lon="116.3110123">
    <tag k="alt_name" v="刚丙庙"/>
    <tag k="description" v="被北京大学扩张吞并的自然地名。刚秉庙算是太监们敬仰的鼻祖神仙，类似关帝里的关公。 这和《红楼梦》庚辰本脂砚斋批语中提到的“刚丙庙”，是同一个地方。周汝昌先生认为刚丙当作“刚炳”，这个庙是明朝司礼太监刚炳（绰号刚铁）为自己建的生祠。杨镰先生则提到他们全家1952年搬到燕东园时，小庙还在，就在燕东园南墙外几十步远，他曾多次到庙里向僧人打听刚丙是谁，据说是一个满族将军，随乾隆下江南时（生殖器）受伤，便在此庙居住养伤。"/>
    <tag k="historic" v="yes"/>
    <tag k="name" v="刚秉庙"/>
    <tag k="name:zh-Hant" v="剛秉廟"/>
    <tag k="place" v="neighbourhood"/>
  </node>
  <node id="13260542962" version="1" timestamp="2025-10-27T00:37:30Z" lat="39.9925805" lon="116.3108206"/>
  <node id="13260542963" version="1" timestamp="2025-10-27T00:37:30Z" lat="39.9925499" lon="116.3108325"/>
  <node id="13260651911" version="1" timestamp="2025-10-27T02:49:22Z" lat="39.9842168" lon="116.3208922"/>
  <node id="13267247602" version="7" timestamp="2026-01-14T11:10:56Z" lat="39.9952585" lon="116.3115873">
    <tag k="description" v="“燕东园”本指上世纪 20 年代美国教会大学燕京大学之东。1952 年之前，“燕东园”又名“东大地”，是燕京大学为自己的教师修建的宿舍（别墅区），一路之隔，稍早创立的清华大学的部分教授也在此居住。"/>
    <tag k="historic" v="yes"/>
    <tag k="name" v="东大地"/>
    <tag k="name:zh-Hant" v="東大地"/>
    <tag k="place" v="neighbourhood"/>
  </node>
