  <node id="5196357163" version="6" timestamp="2025-12-12T22:52:04Z" lat="39.9918957" lon="116.333089">
    <tag k="description" v="因南邻五道口村，故成府路沿线、东王庄南部开设的五道口百货商场和五道口工人俱乐部均以五道口名。改革开放后，成府路沿线的“五道口”已成为东升地区经济文化中心，地铁五道口站的设立也加速了这一进程。位于今北四环以南的原五道口村，其名称已被取代，如今已鲜为人知。"/>
    <tag k="name" v="五道口"/>
    <tag k="name:en" v="Wudaokou"/>
